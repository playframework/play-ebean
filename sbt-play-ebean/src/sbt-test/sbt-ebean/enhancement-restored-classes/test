# sbt 2 restores the class files of an unchanged compile from its cache, as links into the cache
# (https://github.com/sbt/sbt/issues/10036). The enhancement must not write to them: the cache is read-only, and it
# must keep the compiler's output.
$ delete target/out
> compileIncremental
> recordCachedTask
> test
> checkCachedTask

